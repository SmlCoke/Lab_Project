.tran 1p 10n sweep data = sweepdata
.measure tran tpLH TRIG V(NA1) = '0.5*SUPPLY' FALL = 4 TARG V(buffer_out_3) = '0.5*SUPPLY' RISE = 4
.measure tran tpHL TRIG V(NA1) = '0.5*SUPPLY' RISE = 4 TARG V(buffer_out_3) = '0.5*SUPPLY' FALL = 4

.measure tran tp param='(tpLH+tpHL)/2'
.end
